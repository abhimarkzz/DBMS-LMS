# =============================================================================
# AI-Powered Distributed LMS — .gitignore
# =============================================================================

# --- Environment / Secrets ---
.env
*.env
!.env.example
*.pem
*.key
*.p12

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
.Python
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Java / Maven ---
target/
*.class
*.jar
*.war
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# --- Node.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Docker ---
docker-compose.override.yml

# --- Logs ---
logs/
*.log
log/

# --- Uploads (local dev files) ---
uploads/
media/

# --- Database volumes (created by docker-compose) ---
postgres_data/
mongodb_data/
redis_data/
grafana_data/
prometheus_data/

# --- Test artifacts ---
.coverage
coverage.xml
*.coveragerc
test-results/
junit-reports/
