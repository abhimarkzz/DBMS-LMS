# =============================================================================
# AI-Powered Distributed LMS — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=lms_db
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+asyncpg://lms_user:change_me_in_production@postgres:5432/lms_db
DATABASE_URL_SYNC=postgresql://lms_user:change_me_in_production@postgres:5432/lms_db

# --- MongoDB ---
MONGODB_URL=mongodb://mongo_user:change_me_in_production@mongodb:27017/lms_notifications?authSource=admin
MONGODB_DB=lms_notifications
MONGO_INITDB_ROOT_USERNAME=mongo_user
MONGO_INITDB_ROOT_PASSWORD=change_me_in_production

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Redis password (leave empty for dev, set in production)
REDIS_PASSWORD=

# --- JWT ---
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Service URLs (used by API Gateway and inter-service calls) ---
USER_SERVICE_URL=http://user-service:8001
COURSE_SERVICE_URL=http://course-service:8080
ASSIGNMENT_SERVICE_URL=http://assignment-service:8002
RESULT_SERVICE_URL=http://result-service:8081
NOTIFICATION_SERVICE_URL=http://notification-service:3000
AI_SEARCH_SERVICE_URL=http://ai-search-service:8003

# --- API Gateway ---
API_GATEWAY_PORT=8000
GATEWAY_DEBUG=false

# --- Embedding / AI Search ---
# Supported providers: sentence_transformers, openai
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# OpenAI (only needed if EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- File Storage ---
# Supported: local, s3
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=/app/uploads

# S3-compatible (only needed if STORAGE_BACKEND=s3)
S3_BUCKET_NAME=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=

# --- Rate Limiting ---
# Requests per minute per user/IP
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_AI_SEARCH=20
RATE_LIMIT_GENERAL=100

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Environment ---
# development | staging | production
APP_ENV=development

# --- CORS ---
# Comma-separated origins, or * for development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Monitoring ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin

# --- Spring Boot Services ---
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/lms_db
SPRING_DATASOURCE_USERNAME=lms_user
SPRING_DATASOURCE_PASSWORD=change_me_in_production

# --- Node.js Notification Service ---
NODE_ENV=development
NOTIFICATION_SERVICE_PORT=3000
