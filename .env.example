# ============================================================================
# LMS Platform Configuration (.env.example)
# Copy to .env and configure for your target cloud or local development environment
# ============================================================================

# 1. PostgreSQL with pgvector (e.g. Supabase, Neon, AWS RDS, or local PostgreSQL)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/lms_db

# 2. MongoDB Document Database (e.g. MongoDB Atlas or self-hosted MongoDB)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=lms_mongo_db

# 3. Redis In-Memory Cache (e.g. Upstash, AWS ElastiCache, or local Redis)
# Note: LMS includes automated graceful fallback to in-memory caching if Redis is offline
REDIS_URL=redis://localhost:6379/0

# 4. Security & JWT Authentication
JWT_SECRET=supersecret_jwt_key_for_lms_platform_2026_academic
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 5. Groq LLM & Web Research (Primary Provider)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_WEB_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# 6. Local Embedding Model (768-dim vector space for pgvector)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
EMBEDDING_DIMENSION=768

# 7. Legacy Gemini AI & Embeddings (Optional fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 6. Service & Network Configuration
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
